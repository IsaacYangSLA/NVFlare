# Private configuration for the external trusted Fortanix build runner.
# NVFlare passes this file's directory as admin_dir; it does not parse these
# variables. Adapt this template to the reviewed runner's documented interface.
# Keep the configured file outside application build contexts and public output.
WORK_ROOT=/srv/nvflare-fortanix/private-builds
FORTANIX_RUNTIME_IMAGE=fortanix/kata-deploy@sha256:REPLACE_WITH_APPROVED_IMAGE_DIGEST
CCM_ENDPOINT=https://api.armor.fortanix.com
CCM_APPLICATION_ID=REPLACE_WITH_APPROVED_APPLICATION_ID
CCM_BUILD_ID=REPLACE_WITH_APPROVED_BUILD_ID
# Use a fresh non-exportable KEK per immutable release. The runner must resolve
# each release to its own DSM object; never reuse this placeholder as an ID.
DSM_RELEASE_KEY_MAP_FILE=/srv/nvflare-fortanix/private/release-key-map.json
GENPOLICY=/opt/approved-kata/bin/genpolicy
RULES=/opt/approved-kata/share/rules.rego
SETTINGS=/opt/approved-kata/share/genpolicy-settings.json
COSIGN_PUBLIC_KEY_FILE=/srv/nvflare-fortanix/public/cosign.pub
TRUSTED_HANDOFF_DIR=/srv/nvflare-fortanix/private/handoffs
